{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-console.invalid/events/checkpoint.created.schema.json",
  "type": "object",
  "properties": {
    "kind": {
      "const": "checkpoint.created"
    },
    "data": {
      "type": "object",
      "properties": {
        "turnId": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "label": {
          "type": "string"
        }
      },
      "required": [
        "turnId",
        "sha",
        "label"
      ]
    }
  },
  "required": [
    "kind",
    "data"
  ]
}
